{
  "name": "dsh-auto-memory-wh",
  "version": "1.0.0",
  "description": "Automatic persistent memory for DeepSeek Harness with project details, user-level summaries and visual management",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "UPSTREAM.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "docs/storage-recovery.md",
    "docs/trust-ui.md",
    "docs/configuration.md"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2 || 0.2.1-rc.5 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-atomic-write": "0.1.5-rc.2 || 0.2.1-rc.5 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2 || 0.2.1-rc.5 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2 || 0.2.1-rc.5 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2 || 0.2.1-rc.5 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-rc.2 || 0.2.1-rc.5 || 0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2 || 0.2.1-rc.5 || 0.2.2-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-connection": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "react": "^19.3.0",
    "react-dom": "19.3.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.5 <1.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "memory",
    "agent",
    "claude-code"
  ],
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WanderingHeart/dsh-auto-memory-WH.git"
  },
  "homepage": "https://github.com/WanderingHeart/dsh-auto-memory-WH#readme",
  "bugs": {
    "url": "https://github.com/WanderingHeart/dsh-auto-memory-WH/issues"
  }
}
